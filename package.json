{
  "name": "ai-la-trieu-phu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n web,server -c cyan,magenta \"npm run dev\" \"npm run server\"",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "test:server": "tsx server/scripts/smoke.ts",
    "test:prod": "tsx server/scripts/productionSmoke.ts",
    "test:questions": "tsx server/scripts/questionsSmoke.ts",
    "test:scoring": "tsx server/scripts/scoringSmoke.ts",
    "test:snapshot": "tsx server/scripts/snapshotOrderSmoke.ts",
    "test:lifelines": "tsx server/scripts/lifelinesSmoke.ts",
    "test:rooms": "tsx server/scripts/roomSmoke.ts",
    "test:admin": "tsx server/scripts/adminSmoke.ts",
    "test:game": "tsx server/scripts/gameSmoke.ts",
    "test:flow": "tsx server/scripts/gameFlowSmoke.ts",
    "test:wager": "tsx server/scripts/wagerSmoke.ts",
    "test:load": "tsx server/scripts/loadSmoke.ts",
    "test:results": "tsx server/scripts/resultsSmoke.ts",
    "test:resume": "tsx server/scripts/resumeSmoke.ts",
    "test:latency": "tsx server/scripts/latencySmoke.ts",
    "test:vercel": "tsx server/scripts/vercelAdapterSmoke.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "build": "tsc -b && tsc -p tsconfig.server.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "framer-motion": "^11.3.19",
    "gsap": "^3.12.5",
    "howler": "^2.2.4",
    "lottie-react": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/howler": "^2.2.11",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.7",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  }
}
